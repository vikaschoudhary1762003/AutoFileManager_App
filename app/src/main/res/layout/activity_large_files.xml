<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="50dp">

        <TextView
            android:id="@+id/BackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="28sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Large Files"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#111111"/>

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⋮"
            android:textSize="24sp"
            android:gravity="center"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SUMMARY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_orange_card">

                <TextView
                    android:text="📁"
                    android:textSize="38sp"
                    android:gravity="center"
                    android:layout_width="55dp"
                    android:layout_height="55dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="4.12 GB"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="55 Files Found"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Files larger than 100 MB"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>

            <!-- SORT -->
            <TextView
                android:text="Sort by: Size (High to Low)   ▾"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingTop="18dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- FILE 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:gravity="center_vertical">

                <TextView
                    android:text="▶"
                    android:textSize="25sp"
                    android:gravity="center"
                    android:textColor="#6246B9"
                    android:layout_width="45dp"
                    android:layout_height="45dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="movie_trailer_2023.mp4"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#222222"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="/Movies/"
                        android:textSize="11sp"
                        android:textColor="#777777"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <TextView
                    android:text="1.58 GB"
                    android:textStyle="bold"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"/>

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"/>

            <!-- FILE 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:gravity="center_vertical">

                <TextView
                    android:text="▶"
                    android:textSize="25sp"
                    android:textColor="#397B8C"
                    android:gravity="center"
                    android:layout_width="45dp"
                    android:layout_height="45dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Big_Buck_Bunny_1080p.mkv"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="/Movies/"
                        android:textSize="11sp"
                        android:textColor="#777777"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <TextView
                    android:text="886 MB"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"/>

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <!-- MORE FILES -->
            <TextView
                android:text="Design_Resources.zip                         512 MB"
                android:textSize="14sp"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="65dp"/>

            <TextView
                android:text="Ubuntu_22.04.iso                              456 MB"
                android:textSize="14sp"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="65dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- DELETE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:text="0 Files Selected (0 B)"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <Button
            android:text="Delete"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF2929"
            android:layout_width="100dp"
            android:layout_height="50dp"/>

    </LinearLayout>

</LinearLayout>