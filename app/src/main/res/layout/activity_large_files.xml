<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ====================================================== -->
    <!-- TOP BAR -->
    <!-- ====================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="50dp"
        android:paddingBottom="10dp">

        <!-- BACK BUTTON -->
        <TextView
            android:id="@+id/BackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="28sp"
            android:gravity="center"
            android:textColor="#111111"
            android:clickable="true"
            android:focusable="true"/>

        <!-- TITLE -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Large Files"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#111111"/>

        <!-- MORE BUTTON -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⋮"
            android:textSize="24sp"
            android:gravity="center"
            android:textColor="#111111"/>

    </LinearLayout>


    <!-- ====================================================== -->
    <!-- MAIN SCROLL AREA -->
    <!-- ====================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- ================================================== -->
            <!-- SUMMARY CARD -->
            <!-- ================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/bg_orange_card">

                <!-- FOLDER ICON -->
                <TextView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:text="📁"
                    android:textSize="38sp"
                    android:gravity="center"/>


                <!-- SUMMARY INFORMATION -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">


                    <!-- TOTAL LARGE FILE SIZE -->

                    <TextView
                        android:id="@+id/totalLargeFileSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 GB"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#111111"/>


                    <!-- TOTAL LARGE FILE COUNT -->

                    <TextView
                        android:id="@+id/totalLargeFileCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Files Found"
                        android:textSize="14sp"
                        android:textColor="#333333"/>


                    <!-- DESCRIPTION -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Files larger than 100 MB"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_marginTop="5dp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================== -->
            <!-- SORT -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sort by: Size (High to Low)   ▾"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingTop="18dp"
                android:paddingBottom="12dp"/>


            <!-- ================================================== -->
            <!-- SEPARATOR -->
            <!-- ================================================== -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"/>


            <!-- ================================================== -->
            <!-- LARGE FILES WILL BE ADDED HERE FROM JAVA -->
            <!-- ================================================== -->

            <LinearLayout
                android:id="@+id/largeFileContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>


        </LinearLayout>

    </ScrollView>


    <!-- ====================================================== -->
    <!-- BOTTOM DELETE SECTION -->
    <!-- ====================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#FFFFFF">


        <!-- SELECTED FILE INFORMATION -->

        <TextView
            android:id="@+id/selectedFileText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 Files Selected (0 B)"
            android:textSize="14sp"
            android:textColor="#333333"/>


        <!-- DELETE BUTTON -->

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:text="Delete"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF2929"/>

    </LinearLayout>

</LinearLayout>