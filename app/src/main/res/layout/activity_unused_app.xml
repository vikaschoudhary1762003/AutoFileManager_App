<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="#FFFFFF">


    <!-- ===================================================== -->
    <!-- TOP BAR -->
    <!-- ===================================================== -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="60dp"

        android:gravity="center_vertical"

        android:paddingStart="16dp"

        android:layout_marginTop="50dp">


        <!-- BACK BUTTON -->

        <TextView

            android:id="@+id/BackButton"

            android:layout_width="40dp"
            android:layout_height="40dp"

            android:text="←"

            android:textSize="28sp"

            android:gravity="center"/>


        <!-- TITLE -->

        <TextView

            android:layout_width="0dp"
            android:layout_weight="1"

            android:layout_height="wrap_content"

            android:text="Unused Apps"

            android:textSize="20sp"

            android:textStyle="bold"

            android:gravity="center"/>


        <!-- MORE BUTTON -->

        <TextView

            android:text="⋮"

            android:textSize="24sp"

            android:gravity="center"

            android:layout_width="40dp"
            android:layout_height="40dp"/>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- SCROLL VIEW -->
    <!-- ===================================================== -->

    <ScrollView

        android:layout_width="match_parent"

        android:layout_height="0dp"

        android:layout_weight="1"

        android:scrollbars="none">


        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="16dp">


            <!-- ================================================= -->
            <!-- SUMMARY CARD -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="120dp"

                android:gravity="center_vertical"

                android:padding="16dp"

                android:background="@drawable/bg_green_card">


                <!-- ICON -->

                <TextView

                    android:text="▦"

                    android:textSize="42sp"

                    android:textColor="#009B55"

                    android:gravity="center"

                    android:layout_width="55dp"

                    android:layout_height="55dp"/>


                <!-- SUMMARY INFORMATION -->

                <LinearLayout

                    android:orientation="vertical"

                    android:paddingStart="12dp"

                    android:layout_width="0dp"

                    android:layout_weight="1"

                    android:layout_height="wrap_content">


                    <!-- TOTAL SIZE -->

                    <TextView

                        android:id="@+id/totalUnusedAppSize"

                        android:text="0 MB"

                        android:textSize="22sp"

                        android:textStyle="bold"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"/>


                    <!-- TOTAL APPS -->

                    <TextView

                        android:id="@+id/totalUnusedAppCount"

                        android:text="0 Apps Found"

                        android:textSize="14sp"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"/>


                    <!-- DESCRIPTION -->

                    <TextView

                        android:text="Apps not used for 30 days or more."

                        android:textSize="12sp"

                        android:textColor="#666666"

                        android:layout_marginTop="5dp"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SORT -->
            <!-- ================================================= -->

            <TextView

                android:text="Sort by: Size (High to Low)"

                android:textSize="14sp"

                android:textStyle="bold"

                android:paddingTop="18dp"

                android:paddingBottom="10dp"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"/>


            <!-- ================================================= -->
            <!-- TOP SEPARATOR -->
            <!-- ================================================= -->

            <View

                android:layout_width="match_parent"

                android:layout_height="1dp"

                android:background="#EEEEEE"/>


            <!-- ================================================= -->
            <!-- UNUSED APPS WILL BE ADDED HERE -->
            <!-- ================================================= -->

            <LinearLayout

                android:id="@+id/unUsedAppContainer"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"/>


        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- BOTTOM BAR -->
    <!-- ===================================================== -->

    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="70dp"

        android:padding="10dp"

        android:gravity="center_vertical">


        <!-- SELECTED APP COUNT -->

        <TextView

            android:id="@+id/selectedAppText"

            android:text="0 Apps Selected (0 MB)"

            android:layout_width="0dp"

            android:layout_weight="1"

            android:layout_height="wrap_content"/>


        <!-- UNINSTALL BUTTON -->

        <Button

            android:id="@+id/uninstallButton"

            android:text="Uninstall"

            android:textColor="#FFFFFF"

            android:backgroundTint="#FF2929"

            android:layout_width="105dp"

            android:layout_height="50dp"/>

    </LinearLayout>

</LinearLayout>