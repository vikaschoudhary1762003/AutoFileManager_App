<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ========================================================= -->
    <!-- TOP BAR -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="50dp">

        <!-- BACK BUTTON -->

        <TextView
            android:id="@+id/BackButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="←"
            android:textSize="28sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />


        <!-- TITLE -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Image Downloads"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#171717"
            android:gravity="center" />


        <!-- MORE BUTTON -->

        <TextView
            android:id="@+id/moreButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="⋮"
            android:textSize="25sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- SUMMARY CARD -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#EFF8FF">


        <!-- IMAGE ICON -->

        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="▧"
            android:textSize="34sp"
            android:textColor="#2878E8"
            android:background="#DCEEFF" />


        <!-- IMAGE COUNT -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Downloaded Images"
                android:textSize="14sp"
                android:textColor="#555555" />


            <TextView
                android:id="@+id/imageCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Files"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#171717" />

        </LinearLayout>


        <!-- TOTAL SIZE -->

        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Size"
                android:textSize="12sp"
                android:textColor="#777777" />


            <TextView
                android:id="@+id/imageTotalSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2878E8" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- SORT BAR -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Image Files"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#171717" />


        <TextView
            android:id="@+id/sortButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort  ▾"
            android:textSize="14sp"
            android:textColor="#555555"
            android:padding="8dp"
            android:clickable="true" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- IMAGE FILE LIST -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/imageScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <!--
            Java will dynamically add ImageView + filename +
            size into this container.
        -->

        <LinearLayout
            android:id="@+id/imageFileContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp" />

    </ScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM LOCATION -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#F8F9FA">


        <!-- STORAGE ICON -->

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="▣"
            android:textSize="24sp"
            android:textColor="#2878E8" />


        <!-- LOCATION -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Internal Storage  ›  Download"
            android:textSize="13sp"
            android:textColor="#555555" />


        <!-- FILE COUNT -->

        <TextView
            android:id="@+id/imageFileCountBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 files"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#333333" />

    </LinearLayout>

</LinearLayout>