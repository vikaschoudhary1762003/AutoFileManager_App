<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/downloadsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ===================================================== -->
    <!-- TOP BAR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="50dp">

        <!-- BACK -->
        <TextView
            android:id="@+id/BackButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="←"
            android:textSize="30sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />

        <!-- TITLE -->
        <TextView
            android:id="@+id/downloadTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Downloads"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#171717"
            android:gravity="center_vertical"
            android:paddingStart="8dp" />

        <!-- SEARCH -->
        <TextView
            android:id="@+id/searchButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="⌕"
            android:textSize="30sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />

        <!-- FILTER -->
        <TextView
            android:id="@+id/filterButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="☰"
            android:textSize="21sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />

        <!-- MORE -->
        <TextView
            android:id="@+id/moreButton"
            android:layout_width="35dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="⋮"
            android:textSize="26sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- MAIN SCROLL -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/downloadScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- STORAGE SUMMARY CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                >

                <!-- DOWNLOAD ICON -->

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:gravity="center"
                    android:text="↓"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    />

                <!-- FILE COUNT -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="15dp">

                    <TextView
                        android:text="Total Files"
                        android:textSize="14sp"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/totalDownloadFiles"
                        android:text="0 files"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- TOTAL SIZE -->

                <LinearLayout
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:text="Total Size"
                        android:textSize="14sp"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/totalDownloadSize"
                        android:text="2.45 GB"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1558D6"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CATEGORY FILTERS -->
            <!-- ================================================= -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:scrollbars="none"
                android:fillViewport="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <!-- ALL -->

                    <TextView
                        android:id="@+id/categoryAll"
                        android:layout_width="105dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="☷   All"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1558D6"
                        android:layout_marginEnd="10dp" />


                    <!-- IMAGES -->

                    <TextView
                        android:id="@+id/categoryImages"
                        android:layout_width="110dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="▧  Images"
                        android:textSize="15sp"
                        android:textColor="#222222"
                        android:layout_marginEnd="10dp" />


                    <!-- VIDEOS -->

                    <TextView
                        android:id="@+id/categoryVideos"
                        android:layout_width="110dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="▶  Videos"
                        android:textSize="15sp"
                        android:textColor="#222222"
                        android:layout_marginEnd="10dp" />


                    <!-- AUDIO -->

                    <TextView
                        android:id="@+id/categoryAudio"
                        android:layout_width="105dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="♫  Audio"
                        android:textSize="15sp"
                        android:textColor="#222222"
                        android:layout_marginEnd="10dp" />


                    <!-- DOCUMENTS -->

                    <TextView
                        android:id="@+id/categoryDocuments"
                        android:layout_width="125dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="▤  Documents"
                        android:textSize="15sp"
                        android:textColor="#222222"
                        android:layout_marginEnd="10dp" />


                    <!-- OTHER -->

                    <TextView
                        android:id="@+id/categoryOther"
                        android:layout_width="105dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="▣  Other"
                        android:textSize="15sp"
                        android:textColor="#222222"/>

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================================================= -->
            <!-- TODAY -->
            <!-- ================================================= -->

            <TextView
                android:text="Today"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#171717"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <!-- ================================================= -->
            <!-- IMAGE FILE -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/fileImageItem"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <!-- IMAGE PREVIEW -->

                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE" />

                <!-- DETAILS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/imageFileName"
                        android:text="nature_view.jpg"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#171717"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="/storage/emulated/0/Download"
                        android:textSize="11sp"
                        android:textColor="#777777"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- SIZE + TIME -->

                <LinearLayout
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:text="2.45 MB"
                        android:textSize="13sp"
                        android:textColor="#222222"
                        android:gravity="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="10:30 AM"
                        android:textSize="11sp"
                        android:textColor="#777777"
                        android:gravity="end"
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- MORE -->

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="⋮"
                    android:textSize="22sp" />

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <!-- ================================================= -->
            <!-- VIDEO FILE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textSize="28sp"
                    android:textColor="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:text="travel_vlog.mp4"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#171717"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="/storage/emulated/0/Download"
                        android:textSize="11sp"
                        android:textColor="#777777"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:text="125.6 MB"
                        android:textSize="13sp"
                        android:textColor="#222222"
                        android:gravity="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="10:28 AM"
                        android:textSize="11sp"
                        android:textColor="#777777"
                        android:gravity="end"
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="⋮"
                    android:textSize="22sp" />

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <!-- ================================================= -->
            <!-- PDF -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="PDF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:text="invoice_2025.pdf"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#171717"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="/storage/emulated/0/Download"
                        android:textSize="11sp"
                        android:textColor="#777777"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:text="320 KB"
                    android:textSize="13sp"
                    android:layout_width="65dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="⋮"
                    android:textSize="22sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- AUDIO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="♫"
                    android:textSize="30sp"
                    android:textColor="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:text="background_music.mp3"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#171717"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="/storage/emulated/0/Download"
                        android:textSize="11sp"
                        android:textColor="#777777"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:text="4.8 MB"
                    android:textSize="13sp"
                    android:layout_width="65dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="⋮"
                    android:textSize="22sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- YESTERDAY -->
            <!-- ================================================= -->

            <TextView
                android:text="Yesterday"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#171717"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <!-- 🟩 REAL FILE LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/downloadRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingBottom="10dp" />

            <!-- 🟩 SHOWN WHEN NO FILES ARE FOUND -->
            <TextView
                android:id="@+id/noDownloadsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="40dp"
                android:text="No downloaded files found"
                android:textColor="#777777"
                android:textSize="15sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- BOTTOM LOCATION BAR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="#F8FAFC">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="▣"
            android:textSize="25sp"
            android:textColor="#1558D6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="Location"
                android:textSize="11sp"
                android:textColor="#777777"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Internal Storage  ›  Download"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <Button
            android:id="@+id/selectDownloadButton"
            android:layout_width="105dp"
            android:layout_height="48dp"
            android:text="Select"
            android:textSize="14sp"
            android:textColor="#1558D6"
            android:backgroundTint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>