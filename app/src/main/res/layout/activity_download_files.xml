<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/downloadsMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ===================================================== -->
    <!-- TOP BAR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="50dp">

        <!-- BACK -->
        <TextView
            android:id="@+id/BackButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="←"
            android:textSize="30sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />

        <!-- TITLE -->
        <TextView
            android:id="@+id/downloadTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Downloads"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#171717"
            android:gravity="center_vertical"
            android:paddingStart="8dp" />

        <!-- SEARCH -->
        <TextView
            android:id="@+id/searchButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="⌕"
            android:textSize="30sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />

        <!-- FILTER -->
        <TextView
            android:id="@+id/filterButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="☰"
            android:textSize="21sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />

        <!-- MORE -->
        <TextView
            android:id="@+id/moreButton"
            android:layout_width="35dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="⋮"
            android:textSize="26sp"
            android:textColor="#171717"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- MAIN SCROLL -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/downloadScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- STORAGE SUMMARY CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                >

                <!-- DOWNLOAD ICON -->

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:gravity="center"
                    android:text="↓"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />

                <!-- FILE COUNT -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="15dp">

                    <TextView
                        android:text="Total Files"
                        android:textSize="14sp"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/totalDownloadFiles"
                        android:text=" files"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- TOTAL SIZE -->

                <LinearLayout
                    android:layout_width="105dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:text="Total Size"
                        android:textSize="14sp"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/totalDownloadSize"
                        android:text=" GB"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1558D6"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CATEGORY FILTERS -->
            <!-- ================================================= -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:scrollbars="none"
                android:fillViewport="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <!-- ALL -->

                    <TextView
                        android:id="@+id/categoryAll"
                        android:layout_width="105dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="☷   All"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1558D6"
                        android:layout_marginEnd="10dp" />


                    <!-- IMAGES -->


                    <!-- VIDEOS -->


                    <!-- AUDIO -->


                    <!-- DOCUMENTS -->


                    <!-- OTHER -->

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================================================= -->
            <!-- TODAY -->
            <!-- ================================================= -->

            <TextView
                android:text="Today"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#171717"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <!-- ================================================= -->
            <!-- IMAGE FILE -->
            <!-- ================================================= -->


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <!-- ================================================= -->
            <!-- VIDEO FILE -->
            <!-- ================================================= -->


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />


            <!-- ================================================= -->
            <!-- PDF -->
            <!-- ================================================= -->


            <!-- ================================================= -->
            <!-- AUDIO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/downloadFileContainer"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp"
                android:padding="20dp"/>


            <!-- ================================================= -->
            <!-- YESTERDAY -->
            <!-- ================================================= -->


            <!-- 🟩 REAL FILE LIST -->

            <!-- 🟩 SHOWN WHEN NO FILES ARE FOUND -->
            <TextView
                android:id="@+id/noDownloadsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="40dp"
                android:text="No downloaded files found"
                android:textColor="#777777"
                android:textSize="15sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- BOTTOM LOCATION BAR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="#F8FAFC">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="▣"
            android:textSize="25sp"
            android:textColor="#1558D6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="Location"
                android:textSize="11sp"
                android:textColor="#777777"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Internal Storage  ›  Download"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <Button
            android:id="@+id/selectDownloadButton"
            android:layout_width="105dp"
            android:layout_height="48dp"
            android:text="Select"
            android:textSize="14sp"
            android:textColor="#1558D6"
            android:backgroundTint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>