<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- ========================================================= -->
    <!-- MAIN APPLICATION CONTENT                                  -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">


        <!-- ===================================================== -->
        <!-- TOP BAR                                               -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:background="#FFFFFF"
            android:layout_marginTop="30dp">


            <!-- MENU -->

            <TextView
                android:id="@+id/menuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="☰"
                android:textSize="24sp"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />


            <!-- TITLE -->

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Dashboard"
                android:textColor="#171717"
                android:textSize="19sp"
                android:textStyle="bold" />


            <!-- NOTIFICATION -->

            <TextView
                android:id="@+id/notificationButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="●"
                android:textSize="18sp"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />


            <!-- MORE -->

            <TextView
                android:id="@+id/moreButton"
                android:layout_width="35dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⋮"
                android:textSize="28sp"
                android:textColor="#202124" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT                                          -->
        <!-- ===================================================== -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">


                <!-- ================================================= -->
                <!-- STORAGE OVERVIEW CARD                            -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_card">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Storage Overview"
                        android:textColor="#171717"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">


                        <!-- STORAGE CIRCLE -->

                        <FrameLayout
                            android:layout_width="155dp"
                            android:layout_height="155dp"
                            android:layout_marginTop="5dp">


                            <ProgressBar
                                android:id="@+id/storageProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="125dp"
                                android:layout_height="125dp"
                                android:layout_gravity="center"
                                android:max="100"
                                android:progress="0"
                                android:rotation="-90"
                                android:progressDrawable="@drawable/storage_progress" />


                            <LinearLayout
                                android:layout_width="125dp"
                                android:layout_height="125dp"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">


                                <TextView
                                    android:id="@+id/storagePercentage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0%"
                                    android:textColor="#161616"
                                    android:textSize="25sp"
                                    android:textStyle="bold" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Used"
                                    android:textColor="#555555"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </FrameLayout>


                        <!-- STORAGE INFORMATION -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="│  Used"
                                android:textColor="#555555"
                                android:textSize="12sp" />


                            <TextView
                                android:id="@+id/usedStorage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="   0 GB"
                                android:textColor="#171717"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="14dp" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="│  Total"
                                android:textColor="#555555"
                                android:textSize="12sp" />


                            <TextView
                                android:id="@+id/totalStorage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="   0 GB"
                                android:textColor="#171717"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="14dp" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="│  Free"
                                android:textColor="#555555"
                                android:textSize="12sp" />


                            <TextView
                                android:id="@+id/freeStorage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="   0 GB"
                                android:textColor="#171717"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- WARNING -->

                    <TextView
                        android:id="@+id/storageAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠ !"
                        android:textColor="#F44336"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                </LinearLayout>


                <!-- SPACE -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />


                <!-- ================================================= -->
                <!-- QUICK ACTIONS                                      -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    android:textColor="#171717"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />


                <!-- QUICK ACTION ROW 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:orientation="horizontal">


                    <!-- SCAN STORAGE -->


                    <!-- DUPLICATE FILES -->

                    <LinearLayout
                        android:id="@+id/duplicateFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_action"
                        android:clickable="true"
                        android:focusable="true">


                        <TextView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:gravity="center"
                            android:text="▣"
                            android:textSize="25sp"
                            android:textColor="#1478E8" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duplicate Files"
                            android:textSize="15sp"
                            android:textColor="#202124"
                            android:textStyle="bold" />




                    </LinearLayout>


                    <!-- LARGE FILES -->

                    <LinearLayout
                        android:id="@+id/largeFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_action"
                        android:clickable="true"
                        android:focusable="true">


                        <TextView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:gravity="center"
                            android:text="▣"
                            android:textSize="25sp"
                            android:textColor="#F2A900" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Large Files"
                            android:textSize="15sp"
                            android:textColor="#202124"
                            android:textStyle="bold" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/unusedApps"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_action"
                        android:clickable="true"
                        android:focusable="true">


                        <TextView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:gravity="center"
                            android:text="⌘"
                            android:textSize="27sp"
                            android:textColor="#A944E8" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unused Apps"
                            android:textSize="15sp"
                            android:textColor="#202124"
                            android:textStyle="bold" />


                    </LinearLayout>

                </LinearLayout>


                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />


                <!-- QUICK ACTION ROW 2 -->


                <!-- SPACE -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />


                <!-- ================================================= -->
                <!-- CATEGORY                                         -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#171717"
                    android:layout_marginBottom="10dp" />


                <!-- CATEGORY ROW 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:orientation="horizontal"
                    android:layout_gravity="center">


                    <!-- DOWNLOAD FILES -->

                    <LinearLayout
                        android:id="@+id/downloadedFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_action"
                        android:clickable="true"
                        android:focusable="true">


                        <TextView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:gravity="center"
                            android:text=" ↓ "
                            android:textSize="27sp"
                            android:textColor="#E83E8C" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Downloaded"
                            android:textSize="15sp"
                            android:textColor="#202124"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- AUDIO -->

                    <LinearLayout
                        android:id="@+id/audioFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_action"
                        android:clickable="true"
                        android:focusable="true">


                        <TextView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:gravity="center"
                            android:text="♪"
                            android:textSize="27sp"
                            android:textColor="#E83E8C" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audio"
                            android:textSize="15sp"
                            android:textColor="#202124"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- IMAGE FILES -->

                    <LinearLayout
                        android:id="@+id/imagesFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_action"
                        android:clickable="true"
                        android:focusable="true">


                        <TextView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:gravity="center"
                            android:text="🖼"
                            android:textSize="27sp"
                            android:textColor="#E83E8C" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Images"
                            android:textSize="15sp"
                            android:textColor="#202124"
                            android:textStyle="bold" />



                    </LinearLayout>

                </LinearLayout>


                <!-- SPACE -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />


                <!-- CATEGORY ROW 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:orientation="horizontal"
                    android:layout_gravity="center"
                    android:padding="5dp">


                    <!-- VIDEO FILES -->

                    <LinearLayout
                        android:id="@+id/videoFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_action"
                        android:clickable="true"
                        android:focusable="true">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" ▶"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            android:layout_gravity="center" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Videos"
                            android:textSize="15sp"
                            android:textStyle="bold" />



                    </LinearLayout>


                    <!-- DOCUMENTS -->

                    <LinearLayout
                        android:id="@+id/documentFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_action"
                        android:clickable="true"
                        android:focusable="true">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📄"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            android:layout_gravity="center" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Documents"
                            android:textSize="15sp"
                            android:textStyle="bold" />



                    </LinearLayout>


                    <!-- APPS -->

                    <LinearLayout
                        android:id="@+id/appsFiles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_action"
                        android:clickable="true"
                        android:focusable="true">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📱"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            android:layout_gravity="center" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apps"
                            android:textSize="15sp"
                            android:textStyle="bold" />



                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>


        <!-- ===================================================== -->
        <!-- BOTTOM NAVIGATION                                    -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#FFFFFF"
            android:elevation="8dp">


            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="⌂"
                    android:textSize="25sp"
                    android:textColor="#0A9B50" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="#0A9B50"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- FILES -->

            <LinearLayout
                android:id="@+id/navFiles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="□"
                    android:textSize="25sp"
                    android:textColor="#555555" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Files"
                    android:textColor="#555555"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- REPORTS -->

            <LinearLayout
                android:id="@+id/navReports"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="▥"
                    android:textSize="24sp"
                    android:textColor="#555555" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reports"
                    android:textColor="#555555"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- SETTINGS -->

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="⚙"
                    android:textSize="23sp"
                    android:textColor="#555555" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#555555"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- LEFT SLIDING NAVIGATION DRAWER                           -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="16dp">


        <!-- DRAWER HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:text="AutoFileManager"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000" />





        <!-- SCAN STORAGE -->

        <TextView
            android:id="@+id/navScan"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="🔍  Scan Storage"
            android:textSize="16sp"
            android:textColor="#000000"
            android:clickable="true"
            android:focusable="true" />


        <!-- DUPLICATE FILES -->

        <TextView
            android:id="@+id/navDuplicate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="📁  Duplicate Files"
            android:textSize="16sp"
            android:textColor="#000000"
            android:clickable="true"
            android:focusable="true" />


        <!-- LARGE FILES -->

        <TextView
            android:id="@+id/navLarge"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="📦  Large Files"
            android:textSize="16sp"
            android:textColor="#000000"
            android:clickable="true"
            android:focusable="true" />




        <!-- UNUSED APPS -->

        <TextView
            android:id="@+id/navUnused"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="📱  Unused Apps"
            android:textSize="16sp"
            android:textColor="#000000"
            android:clickable="true"
            android:focusable="true" />


        <!-- PUSH SETTINGS TO BOTTOM -->

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <!-- DRAWER SETTINGS -->

        <TextView
            android:id="@+id/drawerSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="⚙  Settings"
            android:textSize="16sp"
            android:textColor="#000000"
            android:clickable="true"
            android:focusable="true" />


        <!-- AUTO MANAGE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="15dp">


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto Manage"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000" />


            <Switch
                android:id="@+id/autoManageSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>


    </LinearLayout>


</androidx.drawerlayout.widget.DrawerLayout>